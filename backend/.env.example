# Copy to .env and adjust.
# SQLite file for the MVP. For production use Postgres, e.g. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./al-forob.db
# Long random string, e.g. from: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Address where this backend is reachable from browsers (used for image URLs)
PUBLIC_URL=http://localhost:8000
# Admin account created by the seed script
ADMIN_EMAIL=admin@alforob.uz
ADMIN_PASSWORD=alforob-demo-2026
FRONTEND_URL=http://localhost:3000
